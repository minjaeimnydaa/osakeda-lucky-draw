# Track the two event projects, not unrelated workspace tools or drafts.
/*
!/.gitignore
!/README.md
!/TRANSFER.md
!/tools/
!/lucky-draw/
!/lucky-draw-v2/

**/node_modules/
**/.env*
!**/.env.example
**/.data/
**/.vercel/
**/test-results/
**/coverage/
**/previews/
**/exports/
**/private-transfer/
**/*.osakeda-backup
**/restore-key*.txt
**/*.sqlite*
**/*.db
**/*.db-*
**/*.csv
**/*.log
**/*.zip
**/.DS_Store
**/Thumbs.db
